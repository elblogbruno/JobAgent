# Job Agent Configuration

# Environment
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-use-a-long-random-string

# Reactive Resume
REACTIVE_RESUME_BASE_URL=https://rxresu.me/api/openapi
REACTIVE_RESUME_API_KEY=your_reactive_resume_api_key_here
# The master CV is chosen in the dashboard (Tus CVs) and stored in
# config/candidate-profile.yaml. There is no env var for it.

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# InfoJobs API (https://developer.infojobs.net -> register your application)
INFOJOBS_CLIENT_ID=your_infojobs_client_id_here
INFOJOBS_CLIENT_SECRET=your_infojobs_client_secret_here
# Obtained through the OAuth2 consent flow: GET /api/infojobs/authorize-url then /api/infojobs/callback
INFOJOBS_ACCESS_TOKEN=
INFOJOBS_REFRESH_TOKEN=
INFOJOBS_REDIRECT_URI=http://localhost:8000/api/infojobs/callback
# Optional: pin one CV from GET /api/infojobs/curriculum, otherwise the primary CV is used
INFOJOBS_CURRICULUM_CODE=

# LLM Providers (Configure at least one)
DEFAULT_LLM_PROVIDER=openai # openai | anthropic | gemini | openrouter | ollama
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Database & Celery
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobagent
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/jobagent
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# Browser Automation
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
BROWSER_USER_DATA_DIR=./browser_sessions

# API & Worker Settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Browser extension -------------------------------------------------------
# The extension authenticates with a pairing token created in the dashboard
# (Role Discovery -> Create pairing token). Set this to false only for a purely
# local setup where you accept unauthenticated imports.
EXTENSION_AUTH_REQUIRED=true
# Where the extension sends the user when they click "Open in Job Agent".
DASHBOARD_URL=http://localhost:3000
